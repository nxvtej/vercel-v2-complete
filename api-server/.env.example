# Redis — build logs pub/sub (required)
REDIS_HOST=127.0.0.1:6379

# Local mode: skip AWS ECS for deploys (use docker run for builds instead)
LOCAL_BUILD=1

# --- AWS ECS (only when LOCAL_BUILD=0) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_CLUSTER=
AWS_TASK_DEFINITION=
AWS_SUBNET1=
AWS_SUBNET2=
AWS_SUBNET3=
AWS_SECURITY_GROUP=
