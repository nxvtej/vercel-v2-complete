# Redis — publish build logs (required)
# Use host.docker.internal when running inside Docker on Mac/Windows
REDIS_HOST=host.docker.internal:6379

# Local mode: copy build output to disk instead of S3
# Inside Docker: mount repo outputs/ to /outputs and use /outputs here
LOCAL_OUTPUT_DIR=/outputs

# Set per deploy (api-server / docker -e overrides these)
PROJECT_ID=test-project
GIT_REPOSITORY__URL=https://github.com/nxvtej/vercel-v1-frontend

# --- AWS S3 (only when LOCAL_OUTPUT_DIR is unset) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
